# ReflectAI environment variables
# --------------------------------
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# NEVER commit .env.local or any file containing real secrets.
#
# Stage 1 does not call any external service, so the app builds and runs
# without these. They are validated (lib/env) when later stages use them.

# --- App ---------------------------------------------------------------------
# Public base URL of the app. Use http://localhost:3000 for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (database + auth) ----------------------------------------------
# Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# The anon key is public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Bypasses row-level security. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (media storage) -------------------------------------------
# Cloudflare dashboard > R2 > Manage API tokens. All SECRET, server only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Gemini (AI) --------------------------------------------------------------
# https://aistudio.google.com/apikey. SECRET, server only.
GEMINI_API_KEY=
# Exact model identifier to use. Required, no default: it is recorded with every
# AI interaction for research integrity, so choose it deliberately.
GEMINI_MODEL=
